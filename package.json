{
  "name": "@ikomida/shared-types",
  "version": "1.2.5",
  "description": "This is the shared types between services, UI and workers etc...",
  "private": false,
  "main": "lib/main.cjs",
  "module": "lib/main.mjs",
  "browser": "lib/main.js",
  "types": "lib/main.d.ts",
  "type": "module",
  "files": [
    "lib/",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "prebuild:types": "rimraf ./build",
    "build": "rimraf ./build ./lib ./docs && rollup -c",
    "build:debug": "rimraf ./build ./lib ./docs && tsc",
    "build:types": "tsc -p ./tsconfig.json --outDir build && api-extractor run",
    "predoc:jsdoc": "rimraf ./docs",
    "docs:jsdoc": "jsdoc -r \"src/**/*.ts\" -R README.md -d ./docs",
    "predoc:typedoc": "rimraf ./docs",
    "docs:typedoc": "typedoc src --out docs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf ./build ./lib ./docs",
    "local": "yarn glogin && ncu -u && yarn && yarn format && yarn lint && yarn build",
    "test": "jest  -c jest.tsc.config.js",
    "glogin": "artifactregistry-auth"
  },
  "author": "Khalid Ait Bellahs (Ti Alti Nivel)",
  "license": "UNLICENSED",
  "devDependencies": {
    "@microsoft/api-extractor": "^7.33.0",
    "@rollup/plugin-json": "^5.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^9.0.1",
    "@types/luxon": "^3.0.1",
    "@typescript-eslint/eslint-plugin": "^5.40.0",
    "@typescript-eslint/parser": "^5.40.0",
    "eslint": "^8.25.0",
    "eslint-config-prettier": "^8.5.0",
    "google-artifactregistry-auth": "^3.0.2",
    "jest": "^29.1.2",
    "jest-runner-tsc": "^1.6.0",
    "jsdoc": "^3.6.11",
    "prettier": "^2.7.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rollup": "^3.1.0",
    "rollup-plugin-auto-external": "^2.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.9.1",
    "tslib": "^2.4.0",
    "typedoc": "^0.23.16",
    "typescript": "^4.8.4",
    "typings": "^2.1.1"
  }
}
